{
  "name": "@worldcoin/web-authenticator",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api \"bun run --cwd apps/web dev\" \"bun run --cwd apps/api dev\"",
    "build": "bun run build:web && bun run build:api",
    "build:web": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "start": "bun run --cwd apps/api start",
    "start:tunnel": "bun --env-file=.env.tunnel apps/api/dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/api typecheck && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "bun test ./apps ./packages ./tests",
    "test:web": "bun run --cwd apps/web test",
    "test:api": "bun run --cwd apps/api test",
    "test:browser": "bun run build && playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@happy-dom/global-registrator": "20.13.2",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.3.11",
    "@types/node": "20.19.25",
    "axe-core": "4.13.0",
    "concurrently": "9.2.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "viem": "2.56.0"
  }
}
