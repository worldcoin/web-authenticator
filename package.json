{
  "name": "@worldcoin/web-authenticator",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "preview": "bun run --cwd web preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "bun run --cwd web typecheck && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "bun test ./web/test ./packages ./tests",
    "test:web": "bun run --cwd web test",
    "test:browser": "bun run build && playwright test -c tests/e2e/playwright.config.ts",
    "build:cf": "bun run build",
    "deploy:cf": "wrangler deploy",
    "cf:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@happy-dom/global-registrator": "20.13.2",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.3.11",
    "@types/node": "20.19.25",
    "axe-core": "4.13.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "viem": "2.56.0",
    "wrangler": "4.153.0"
  }
}
