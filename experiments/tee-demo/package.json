{
	"name": "world-id-web-authenticator",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"packageManager": "bun@1.3.5",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "vite build",
		"start": "bun src/server/index.ts",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test tests",
		"build:selfie-helper": "cargo build --locked --config src/server/face-enrollment-helper/build-config.toml --manifest-path src/server/face-enrollment-helper/Cargo.toml",
		"dev:api": "bun --watch src/server/index.ts",
		"dev:web": "vite"
	},
	"dependencies": {
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@types/qrcode": "^1.5.5",
		"@worldcoin/walletkit-web": "file:../../../walletkit-selfie-integration/worldcoin-walletkit-web-0.22.1.tgz",
		"clsx": "^2.1.1",
		"lossless-json": "4.3.1",
		"motion": "^12.23.22",
		"onnxruntime-web": "1.30.0",
		"qrcode": "^1.5.4",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-router-dom": "^7.18.4",
		"tailwind-merge": "^3.3.1",
		"viem": "2.56.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@eslint/js": "^9",
		"@tailwindcss/postcss": "^4",
		"@types/bun": "^1.4.2",
		"@types/node": "^20",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^9",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"prettier": "^3.6.2",
		"prettier-plugin-sort-imports-desc": "^1.0.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3"
	},
	"prettier": {
		"semi": false,
		"tabWidth": 4,
		"useTabs": true,
		"printWidth": 120,
		"singleQuote": true,
		"trailingComma": "es5",
		"arrowParens": "avoid",
		"bracketSpacing": true,
		"plugins": [
			"prettier-plugin-sort-imports-desc"
		]
	},
	"type": "module"
}
