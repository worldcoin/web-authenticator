{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-authenticator-dev",
  "main": "api/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // Terraform manages authenticator.toolsforhumanity.dev and its TFH Access policy.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./.artifacts/cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Public identifiers for the Access app protecting authenticator.toolsforhumanity.dev.
  // Update the audience if Terraform recreates that Access application.
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "internal",
    "CF_ACCESS_TEAM_DOMAIN": "toolsforhumanity.cloudflareaccess.com",
    "CF_ACCESS_AUD": "d0a462b581bb5cc080282fb737691d2fa93332168d859514a0f2ab7fc6692d46"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Terraform owns Foundation cross-account hostname routing. GitHub Actions
  // deploys these Workers in order; Workers Builds continues to own dev only.
  "env": {
    "sandbox": {
      "name": "web-authenticator-sandbox",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "sandbox",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": ""
      }
    },
    "production": {
      "name": "web-authenticator-prod",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": ""
      }
    }
  }
}
