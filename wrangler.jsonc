{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets only: there is no Worker script, so every request is answered from web/dist.
  // Security and cache headers come from the generated web/dist/_headers file.
  "name": "web-authenticator-dev",
  "account_id": "ae97c44fcd31b9289a7455120d2698b2",
  "compatibility_date": "2026-10-26",
  // Terraform manages authenticator.toolsforhumanity.dev and its TFH Access policy.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    // The router in web/App.tsx owns every path that is not a file.
    "not_found_handling": "single-page-application"
  },
  // Keep staging's existing Worker identity stable. Terraform owns hostname routing;
  // production is deployed manually by Actions.
  "env": {
    "staging": { "name": "web-authenticator-dev" },
    "production": { "name": "web-authenticator-prod" }
  }
}
