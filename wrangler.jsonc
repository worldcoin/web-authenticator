{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-authenticator-dev",
  "main": "api/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // Terraform manages authenticator.toolsforhumanity.dev and its TFH Access policy.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./.artifacts/cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // The administrator supplies these after creating the TFH-only Access app.
  // Empty values deliberately prevent the Worker from serving any content.
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": ""
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
